# MySQL
NIORA_DATABASE_HOST=127.0.0.1
NIORA_DATABASE_PORT=3306
NIORA_DATABASE_NAME=niora
NIORA_DATABASE_MIGRATION_USER=niora_migration
NIORA_DATABASE_MIGRATION_PASSWORD=replace-with-local-only-migration-password
NIORA_DATABASE_APPLICATION_USER=niora_application
NIORA_DATABASE_APPLICATION_PASSWORD=replace-with-local-only-application-password
NIORA_DATABASE_ADMIN_PASSWORD=replace-with-local-only-admin-password
NIORA_DATABASE_POOL_SIZE=5
NIORA_DATABASE_MAX_OVERFLOW=5
NIORA_DATABASE_POOL_TIMEOUT_SECONDS=30
NIORA_DATABASE_POOL_RECYCLE_SECONDS=1800
